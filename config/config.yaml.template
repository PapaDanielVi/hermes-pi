# Browser HTTP API for local web search/fetch
tools:
  http_request:
    enabled: true
    base_url: "http://localhost:{{BROWSER_SERVER_PORT}}"

# LLM providers (API keys passed via environment in docker-compose.yml)
providers:
  anthropic:
    enabled: true
  openrouter:
    enabled: true

# Active model — OpenRouter free tier by default, override via OPENROUTER_MODEL in .env
model:
  provider: openrouter
  default: "{{OPENROUTER_MODEL}}"
  base_url: ''
  api_mode: chat_completions

# Multi-agent task board (reachable as /kanban from Telegram)
kanban:
  dispatch_in_gateway: true
  dispatch_interval_seconds: 60

# Memory settings
memory:
  enabled: true

# Logging
logging:
  level: "info"