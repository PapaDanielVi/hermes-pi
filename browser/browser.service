[Unit]
Description=Hermes Browser Server (Playwright + Chromium loopback fallback)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/hermes-pi/browser
Environment="BROWSER_SERVER_HOST=127.0.0.1"
Environment="BROWSER_SERVER_PORT={{BROWSER_SERVER_PORT}}"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/hermes-pi/venv/bin/python /opt/hermes-pi/browser/browser_server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening - relaxed for Pi Playwright cache access
NoNewPrivileges=true
ProtectHome=false

[Install]
WantedBy=multi-user.target
