[Unit]
Description=Hermes Browser Server (Playwright + Chromium)
After=network.target

[Service]
Type=simple
WorkingDirectory={{REPO_DIR}}/browser
Environment="BROWSER_SERVER_PORT={{BROWSER_SERVER_PORT}}"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
# Use xvfb-run for headless Chromium without X11 display
ExecStart=/usr/bin/xvfb-run --auto-server-num --server-arg="-screen 0 1920x1080x24" /usr/bin/python3 {{REPO_DIR}}/browser/browser_server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening - relaxed for Pi deployment
NoNewPrivileges=true
# ProtectHome must be disabled for Playwright cache access
ProtectHome=false

[Install]
WantedBy=multi-user.target
