# .env — normally generated for you by ./install.sh (it prompts for each value).
# This file is the canonical list of fields. You can copy it to .env and edit by
# hand, but the interactive installer is the easier path.

# ── Telegram channel (optional at install time, can be set later) ──
# Get your bot token from @BotFather. Leave empty to skip and configure the
# channel later from inside the container (docker exec -it hermes hermes config).
TELEGRAM_BOT_TOKEN=

# Telegram user IDs allowed to talk to the bot (comma-separated, no spaces).
# Get each ID from @userinfobot.
TELEGRAM_ALLOWED_USERS=

# ── GitHub memory repository (optional at install time) ──
# Backs up ~/.hermes memory and skills to a private GitHub repo every 30
# minutes and on graceful shutdown. Leave both empty to keep everything local
# to this Pi with no off-device copy — set both together to enable it, later
# via ./install.sh if you skip it now.
# Format: https://github.com/owner/repo
GITHUB_MEMORY_REPO=

# Personal Access Token for the memory repo (needs repo scope).
GITHUB_TOKEN=

# ── LLM providers (optional at install time, can be set later) ──
# Leave empty to skip and configure the provider later inside the container.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Runtime tuning (set automatically; override only if you know you need to) ──
# Memory cap for the Hermes container. scripts/00_preflight.sh picks a value based
# on the board's RAM (e.g. 3G on an 8 GB Pi 5, 1500M on a 2 GB Pi 4).
HERMES_MEM_LIMIT=3G

# Browser server port (must match config.yaml; default 5555).
BROWSER_SERVER_PORT=5555

# Hermes dashboard (1=enabled, 0=disabled).
HERMES_DASHBOARD=1

# ── Voice mode ────────────────────────────────────────────────
# Send voice notes to the bot; it transcribes them and can reply with spoken audio.
# Toggle per-chat at runtime with /voice on, /voice tts, /voice off, /voice status.
#
# STT (speech-to-text) — transcribes incoming Telegram voice notes.
#   local  : faster-whisper runs inside the container, no key needed (default)
#   groq   : Groq cloud Whisper, requires GROQ_API_KEY
#   openai : OpenAI cloud Whisper, requires VOICE_TOOLS_OPENAI_KEY
# On 2-4 GB boards consider STT_MODEL=tiny to keep RAM usage lower.
#
# TTS (text-to-speech) — sends replies as Telegram voice bubbles.
#   edge       : Microsoft Edge TTS, free, no key needed (default)
#   piper      : fully offline on-device TTS, no key needed
#   elevenlabs : ElevenLabs cloud, requires ELEVENLABS_API_KEY
#   openai     : OpenAI TTS, requires VOICE_TOOLS_OPENAI_KEY
HERMES_VOICE_ENABLED=1
HERMES_STT_PROVIDER=local
HERMES_STT_MODEL=base
HERMES_TTS_PROVIDER=edge
HERMES_TTS_VOICE=en-US-AriaNeural

# Cloud voice API keys (leave empty when using local/edge providers above).
GROQ_API_KEY=
ELEVENLABS_API_KEY=
VOICE_TOOLS_OPENAI_KEY=
