# .env — normally generated for you by ./install.sh (it prompts for each value).
# This file is the canonical list of fields. You can copy it to .env and edit by
# hand, but the interactive installer is the easier path.

# ── Telegram channel (optional at install time, can be set later) ──
# Get your bot token from @BotFather. Leave empty to skip and configure the
# channel later from inside the container (docker exec -it hermes hermes config).
TELEGRAM_BOT_TOKEN=

# Telegram user IDs allowed to talk to the bot (comma-separated, no spaces).
# Get each ID from @userinfobot.
TELEGRAM_ALLOWED_USERS=

# ── GitHub memory repository (required) ──
# Format: https://github.com/owner/repo
GITHUB_MEMORY_REPO=

# Personal Access Token for the memory repo (needs repo scope).
GITHUB_TOKEN=

# ── LLM providers (optional at install time, can be set later) ──
# Leave empty to skip and configure the provider later inside the container.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Runtime tuning (set automatically; override only if you know you need to) ──
# Memory cap for the Hermes container. scripts/00_preflight.sh picks a value based
# on the board's RAM (e.g. 3G on an 8 GB Pi 5, 1500M on a 2 GB Pi 4).
HERMES_MEM_LIMIT=3G

# Browser server port (must match config.yaml; default 5555).
BROWSER_SERVER_PORT=5555

# Hermes dashboard (1=enabled, 0=disabled).
HERMES_DASHBOARD=1
