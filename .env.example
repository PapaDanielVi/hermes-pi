# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Telegram user IDs (comma-separated, no spaces)
# Get your ID from @userinfobot
TELEGRAM_ALLOWED_USERS=

# GitHub Memory Repository
# Format: https://github.com/owner/repo (will be converted to authenticated URL)
GITHUB_MEMORY_REPO=

# Personal Access Token for the memory repo (needs repo scope)
GITHUB_TOKEN=

# Optional: Override browser server port (default: 5555)
# BROWSER_SERVER_PORT=5555

# LLM Provider API Keys (optional, set as needed)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Hermes dashboard (1=enabled, 0=disabled)
# HERMES_DASHBOARD=1
